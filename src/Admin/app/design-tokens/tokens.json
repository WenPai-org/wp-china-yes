{
  "$schema_note": "文派后台设计 token 唯一来源。改这里，然后跑 python3 scripts/build-tokens.py。css/wenpai-tokens.css 是生成物，不要手改。",
  "$version": "0.3.2",
  "scope": ".wenpai-app",
  "groups": {
    "color": {
      "prefix": "--wenpai-",
      "desc": "颜色。名字沿用 0.2.x 的 --wenpai-*，产品可在 body.{slug}-admin .wenpai-app 覆盖 accent 三件套。",
      "tokens": {
        "accent": {
          "value": "#3858e9",
          "desc": "强调色（OPEN DECISION：与 WP/Gutenberg 强调色同值，见 docs/design-system/decisions.md D-01）"
        },
        "accent-hover": {
          "value": "#2c47c5",
          "desc": "主按钮悬停；info 提示文字"
        },
        "accent-soft": {
          "value": "#eef1fd",
          "desc": "选中底、info 提示底、.next 底"
        },
        "accent-line": {
          "value": "#d9e0fb",
          "desc": ".next 边框"
        },
        "on-accent": {
          "value": "#ffffff",
          "desc": "强调色上的字和图标"
        },
        "ink": {
          "value": "#1e1e1e",
          "desc": "主文字"
        },
        "ink-2": {
          "value": "#50575e",
          "desc": "次文字"
        },
        "ink-3": {
          "value": "#646970",
          "desc": "弱文字（白底 5.53:1，#f0f0f1 底 4.86:1）"
        },
        "line": {
          "value": "#e0e0e0",
          "desc": "顶栏下边、页脚上边、步骤线"
        },
        "line-soft": {
          "value": "#f0f0f1",
          "desc": "卡内分割、代码块底、可点行悬停底"
        },
        "line-card": {
          "value": "#e5e5e5",
          "desc": ".card 边框"
        },
        "line-strong": {
          "value": "#c3c4c7",
          "desc": "次按钮、分段控件边框（带文字，不靠边框识别）"
        },
        "line-hover": {
          "value": "#8c8f94",
          "desc": "choice 卡悬停边"
        },
        "control-line": {
          "value": "#8c8f94",
          "desc": "输入框 / 下拉 / 多行输入边框（白底 3.24:1，满足 WCAG 1.4.11）"
        },
        "control-line-hover": {
          "value": "#646970",
          "desc": "输入框悬停边"
        },
        "track-off": {
          "value": "#8c8f94",
          "desc": "开关关闭轨道（白底 3.24:1）"
        },
        "track-locked": {
          "value": "#dcdcde",
          "desc": "锁定 / 禁用开关轨道（禁用态不要求对比）"
        },
        "bg": {
          "value": "#f0f0f1",
          "desc": "页底。另外挂在 body.wenpai-ui-page 上，给 #wpcontent 等壳外容器用"
        },
        "card": {
          "value": "#ffffff",
          "desc": "卡、输入框底"
        },
        "ok": {
          "value": "#00a32a",
          "desc": "成功圆点、完成步骤底"
        },
        "ok-soft": {
          "value": "#edfaef",
          "desc": "成功底"
        },
        "ok-ink": {
          "value": "#007017",
          "desc": "成功文字（ok-soft 底 5.86:1）"
        },
        "warn": {
          "value": "#dba617",
          "desc": "警告圆点（只做点，不做字）"
        },
        "warn-soft": {
          "value": "#fbf3dc",
          "desc": "警告底"
        },
        "warn-ink": {
          "value": "#7a5a06",
          "desc": "警告文字和图标（warn-soft 底 5.76:1）。0.2.5 的 #9a7208 只有 3.96:1，已换"
        },
        "bad": {
          "value": "#d63638",
          "desc": "危险边框、圆点；白底文字 4.73:1"
        },
        "bad-soft": {
          "value": "#fbe9ea",
          "desc": "危险底"
        },
        "bad-ink": {
          "value": "#b32d2e",
          "desc": "危险底上的文字（bad-soft 底 5.39:1）。0.2.5 直接用 #d63638 只有 4.04:1，已换"
        },
        "bad-ink-strong": {
          "value": "#8a2424",
          "desc": "危险提示条正文"
        },
        "mute": {
          "value": "#646970",
          "desc": "默认 pill 圆点"
        },
        "mute-soft": {
          "value": "#f0f0f1",
          "desc": "默认 pill / tile 底"
        }
      }
    },
    "focus": {
      "prefix": "--wenpai-focus-",
      "desc": "焦点环。用 outline 画，forced-colors（Windows 高对比）下仍可见。",
      "tokens": {
        "color": {
          "value": "{color.accent}",
          "desc": "环色（白底 5.61:1，#f0f0f1 底 4.93:1）"
        },
        "width": {
          "value": "2px"
        },
        "offset": {
          "value": "2px"
        },
        "halo": {
          "value": "{color.accent-soft}",
          "desc": "输入框聚焦外晕，只是装饰，不能单独当焦点指示"
        }
      }
    },
    "space": {
      "prefix": "--wenpai-space-",
      "desc": "间距刻度，4px 栅格。0.2.x 里的 6/10/14/18/22/28 等值是历史微调，按 foundations.md §3 逐步收敛，不新增。",
      "tokens": {
        "1": {
          "value": "4px"
        },
        "2": {
          "value": "8px"
        },
        "3": {
          "value": "12px"
        },
        "4": {
          "value": "16px"
        },
        "5": {
          "value": "20px"
        },
        "6": {
          "value": "24px"
        },
        "7": {
          "value": "28px"
        },
        "8": {
          "value": "32px"
        },
        "9": {
          "value": "36px"
        },
        "12": {
          "value": "48px"
        }
      }
    },
    "radius": {
      "prefix": "--wenpai-radius",
      "desc": "圆角。--wenpai-radius（无后缀）保留为卡片圆角，兼容 0.2.x。",
      "tokens": {
        "": {
          "value": "12px",
          "desc": "卡片（= xl，兼容名）"
        },
        "-sm": {
          "value": "6px",
          "desc": "按钮、输入框、分段"
        },
        "-md": {
          "value": "8px",
          "desc": "品牌标、代码块、厂商标、可点行"
        },
        "-lg": {
          "value": "10px",
          "desc": "tile、提示条、choice 卡、确认门、prov、开关轨道"
        },
        "-xl": {
          "value": "12px",
          "desc": "卡片、.next、pill、scope（高 24，等于全圆；窄屏折行时仍是 12 圆角）"
        }
      }
    },
    "font": {
      "prefix": "--wenpai-font",
      "desc": "字体栈。后台不引 web font。",
      "tokens": {
        "": {
          "value": "-apple-system, \"Noto Sans\", \"Helvetica Neue\", Helvetica, Arial, \"PingFang SC\", \"Hiragino Sans GB\", \"Noto Sans CJK SC\", \"Source Han Sans SC\", \"Microsoft YaHei\", sans-serif"
        },
        "-mono": {
          "value": "ui-monospace, SFMono-Regular, Menlo, monospace"
        }
      }
    },
    "text": {
      "prefix": "--wenpai-text-",
      "desc": "字号。配对行高见 leading。",
      "tokens": {
        "caption": {
          "value": "12px",
          "desc": "保存回执、hint、choice-group、prov"
        },
        "meta": {
          "value": "13px",
          "desc": "说明、pill、表头、页脚、lede（wp-admin 内）"
        },
        "body": {
          "value": "14px",
          "desc": "正文、按钮、Tab、字段名"
        },
        "title": {
          "value": "16px",
          "desc": "卡标题、节标题"
        },
        "brand": {
          "value": "17px",
          "desc": "顶栏品牌名"
        },
        "h1": {
          "value": "24px",
          "desc": "页标题、概览大数"
        },
        "display": {
          "value": "26px",
          "desc": "向导标题"
        }
      }
    },
    "leading": {
      "prefix": "--wenpai-leading-",
      "tokens": {
        "caption": {
          "value": "18px"
        },
        "meta": {
          "value": "20px"
        },
        "body": {
          "value": "22px"
        },
        "title": {
          "value": "24px"
        },
        "h1": {
          "value": "32px"
        },
        "display": {
          "value": "34px"
        }
      }
    },
    "weight": {
      "prefix": "--wenpai-weight-",
      "desc": "字重。层级靠字号、颜色、留白，不靠字重（decisions.md D-02）。",
      "tokens": {
        "regular": {
          "value": "400"
        }
      }
    },
    "elevation": {
      "prefix": "--wenpai-shadow",
      "desc": "阴影。文派后台表面默认无阴影，靠边框分层。",
      "tokens": {
        "": {
          "value": "0 1px 2px rgba(0, 0, 0, .04)",
          "desc": "保留给浮层（0.2.x 定义过但未使用）"
        },
        "-none": {
          "value": "none"
        }
      }
    },
    "motion": {
      "prefix": "--wenpai-motion-",
      "desc": "动效。prefers-reduced-motion: reduce 时 kit 关闭过渡和转圈。",
      "tokens": {
        "fast": {
          "value": "120ms",
          "desc": "边框、阴影、颜色反馈"
        },
        "base": {
          "value": "150ms",
          "desc": "开关滑块"
        },
        "slow": {
          "value": "200ms",
          "desc": "tile 状态变色"
        },
        "fade": {
          "value": "400ms",
          "desc": "提示条淡出"
        },
        "spin": {
          "value": "800ms",
          "desc": "转圈一周"
        },
        "ease": {
          "value": "ease",
          "desc": "默认缓动"
        }
      }
    },
    "z": {
      "prefix": "--wenpai-z-",
      "desc": "层级。必须低于 WP 侧栏（#adminmenuwrap 9990）和管理栏（#wpadminbar 99999）。0.2.x 没有用到 z-index。",
      "tokens": {
        "base": {
          "value": "0"
        },
        "raised": {
          "value": "1"
        },
        "popover": {
          "value": "100"
        }
      }
    },
    "size": {
      "prefix": "--wenpai-size-",
      "desc": "布局尺寸。",
      "tokens": {
        "wrap": {
          "value": "1120px",
          "desc": "内容最大宽"
        },
        "head": {
          "value": "56px",
          "desc": "顶栏高"
        },
        "control": {
          "value": "36px",
          "desc": "输入框、主按钮高"
        },
        "control-max": {
          "value": "28rem",
          "desc": "输入框最大宽"
        },
        "mark": {
          "value": "28px",
          "desc": "品牌标"
        },
        "tile": {
          "value": "36px",
          "desc": "tile"
        },
        "label-col": {
          "value": "280px",
          "desc": "字段标签列（高级设置）"
        },
        "wizard": {
          "value": "680px",
          "desc": "向导宽"
        }
      }
    }
  },
  "breakpoints": {
    "desc": "CSS 变量不能用在 @media 里；这里只做文档和 lint 依据，生成器写成注释。",
    "values": {
      "field": {
        "value": "960px",
        "desc": "≤960：字段行（.field）单列；≥961 两栏（MEMORY P-2）。与栅格 wide=1100 分列，勿合并"
      },
      "wide": {
        "value": "1100px",
        "desc": "≤1100：栅格（.wenpai-grid-*）改一列；字段行断点见 field（P-2）。与 field=960 分列，勿合并"
      },
      "admin": {
        "value": "782px",
        "desc": "≤782：WP 后台移动断点。顶栏折两行（品牌+帮助/反馈一行，页签一行），帮助/反馈只留图标"
      },
      "narrow": {
        "value": "600px",
        "desc": "≤600：WP 管理栏切换点。只做防溢出，不再改顶栏结构"
      }
    }
  },
  "extra_scopes": {
    "body.wenpai-ui-page": [
      "color.bg"
    ],
    "$desc": "壳外（#wpcontent / #wpbody）只能读到这里列出的 token。只在 kit 页面的 body 上，不是 :root。"
  }
}
